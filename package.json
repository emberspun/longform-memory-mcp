{
  "name": "longform-memory-mcp",
  "version": "0.1.1",
  "description": "MCP server that gives your AI writing assistant a constant-size memory of a long document. Chapter 1000 costs the same tokens as chapter 10. Local-only: no account, no API key, no network.",
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "mcp-server",
    "claude",
    "cursor",
    "llm",
    "long-context",
    "context-window",
    "token-budget",
    "memory",
    "ai-writing",
    "continuity",
    "novel",
    "local-first"
  ],
  "homepage": "https://emberspun.com/open-source/longform-memory",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emberspun/longform-memory-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/emberspun/longform-memory-mcp/issues"
  },
  "license": "MIT",
  "author": "Emberspun",
  "type": "module",
  "bin": {
    "longform-memory-mcp": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/chmod-bin.mjs",
    "start": "node dist/bin.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "longform-memory": "^0.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
